# Copy this file to .env.local for local development.
# .env.local is gitignored — your laptop IP stays on your machine.
# Expo loads .env.local with HIGHER priority than .env, so it overrides production URLs.

# Backend running on your laptop (replace IP with your own LAN IP)
EXPO_PUBLIC_API_BASE_URL=http://192.168.10.177:3000

# AI server running on your laptop (replace IP with your own LAN IP)
EXPO_PUBLIC_AI_SERVER_WS_BASE=ws://192.168.10.177:8000
