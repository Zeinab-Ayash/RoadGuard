# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real secrets.

PORT=3000

# Long random string used to sign JWT tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Supabase project credentials (Settings → API in the Supabase dashboard).
# Use the SERVICE_ROLE key on the server (NOT the anon key) — it bypasses RLS.
# Keep this key secret; it has full DB access.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
